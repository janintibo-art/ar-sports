; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="AR Sports"
config/description="Bowling, pétanque, ping-pong et fléchettes en réalité augmentée sur Quest 3."
config/version="0.30.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Sound="*res://scripts/sound.gd"
CuePolish="*res://scripts/billard/cue_polish.gd"

[display]

window/vsync/vsync_mode=0

[layer_names]

3d_physics/layer_1="Monde"
3d_physics/layer_2="Interface"
3d_physics/layer_3="Quilles"
3d_physics/layer_4="Boule"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=90
common/max_physics_steps_per_frame=4
jolt_physics_3d/limits/max_linear_velocity=25.0
jolt_physics_3d/limits/max_angular_velocity=60.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/foveation_level=2
openxr/foveation_dynamic=true
shaders/enabled=true
openxr/extensions/meta/passthrough=true
